# PROPERTY LK - ENVIRONMENT CONFIGURATION
# Optional: Pre-configure Cloudinary for unsigned client-side uploads
# (Can also be configured anytime directly within the Admin Settings UI)

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: MongoDB Atlas connection string for the optional serverless backend
# (api/db.js and server.js). The app works fully client-side without it.
# Never commit real credentials - set this in Vercel Project Settings or a local .env file.
MONGODB_URI=
